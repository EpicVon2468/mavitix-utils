#! /usr/bin/env bash

set -ex

rm -rf target
mkdir -p target/release
mkdir -p target/release/tmp
mkdir -p target/release/artefacts

if [ -z "$CPP" ]; then CPP="cpp"; fi
if [ -z "$AS" ]; then AS="as"; fi
if [ -z "$CC" ]; then CC="cc"; fi
if [ -z "$LD" ]; then LD="ld"; fi
if [ -z "$AR" ]; then AR="ar"; fi
if [ -z "$RANLIB" ]; then RANLIB="ranlib"; fi
if [ -z "$RUSTC" ]; then RUSTC="rustc"; fi

case "$($CC --version)" in
	*"clang"*)
		CC_TYPE="clang"
		;;
	*"gcc"*)
		CC_TYPE="gcc"
		;;
	*)
		CC_TYPE="unknown"
		;;
esac

ASFLAGS+=" -mnaked-reg --warn"
ASFLAGS+=" -gdwarf-5 -g --gstabs --gsframe-3"

architecture="$(uname -m | sed -e 's/x86_64/x86-64/g')"

if [ "$architecture" = "x86-64" ]; then
	ASFLAGS+=" --64 -O2 -mintel64 -msyntax=intel -mmnemonic=intel"
fi

CPPFLAGS+=" -fdirectives-only -E -nostdlib -nostdinc -std=c23"
CPPFLAGS+=" -Wpedantic -Wextra -Wall -Werror -Wundef -Wtrigraphs"

$CPP $CPPFLAGS "src/crt/crt1_$architecture.S" -o target/release/tmp/crt1.s
$AS $ASFLAGS target/release/tmp/crt1.s -o target/release/artefacts/crt1.o

$CPP $CPPFLAGS src/stddef/__mavitix_unreachable_impl.S -o target/release/tmp/__mavitix_unreachable_impl.s
$AS $ASFLAGS target/release/tmp/__mavitix_unreachable_impl.s -o target/release/artefacts/__mavitix_unreachable_impl.o

# https://clang.llvm.org/docs/ClangCommandLineReference.html#cmdoption-clang-fcf-protection
# https://gcc.gnu.org/onlinedocs/gcc/Instrumentation-Options.html#index-fcf-protection
# https://doc.rust-lang.org/nightly/unstable-book/compiler-flags/cf-protection.html
CFLAGS+=" -fcf-protection -fno-fast-math"
CFLAGS+=" -nostdlib -nostdinc -nostartfiles -nodefaultlibs -nolibc -ffreestanding"
CFLAGS+=" -isysteminclude -std=c23 -O3 -m64 -march=native -mtune=native -fpic"
CFLAGS+=" -g -g3 -gdwarf-5 -gdwarf64"
CFLAGS+=" -Wpedantic -Wextra -Wall -Werror -Wundef -Wtrigraphs -Wunknown-pragmas -Wno-error=unused-parameter -Wno-error=unused-variable"
case "$CC_TYPE" in
	"clang")
		CFLAGS+=" -Wno-error=#warnings -Wno-error=unused-command-line-argument"
		CFLAGS+=" -fno-knr-functions -fno-digraphs -fno-trigraphs -femit-all-decls"
		CFLAGS+=" -gembed-source"
		;;
	"gcc")
		CFLAGS+=" -Wno-error=attributes"
		# https://gcc.gnu.org/onlinedocs/gcc/Debugging-Options.html#index-gas-loc-support
		# Surprisingly, even source-built clang 23 doesn't support this.
		CFLAGS+=" -gas-loc-support"
		;;
	*)
		;;
esac

$CC $CFLAGS src/gnu/libc-version.c -c -o target/release/artefacts/libc-version.o
$CC $CFLAGS src/stdio/__init.c -c -o target/release/artefacts/stdio__init.o
$CC $CFLAGS src/crt/start_main.c -c -o target/release/artefacts/start_main.o
$CC $CFLAGS src/env/environ.c -c -o target/release/artefacts/environ.o

# TODO: `-Z implicit-sysroot-deps=no` means the build-std stuff for `$(uname -m)-unknown-linux-none` could potentially work
RUSTFLAGS+=" -Z unstable-options -C debug-assertions=no -C panic=immediate-abort -C strip=none -C link-dead-code=on"
RUSTFLAGS+=" -C link-arg=-nostdlib -C link-arg=-nostdinc -C link-arg=-nostartfiles -C link-arg=-nodefaultlibs -C link-arg=-nolibc -C link-arg=-ffreestanding"
RUSTFLAGS+=" -C link-arg=-fcf-protection -C link-arg=-fno-fast-math -Z cf-protection=full -C overflow-checks=off"
RUSTFLAGS+=" -C target-cpu=native -Z tune-cpu=native -C lto=fat -C codegen-units=1 -C opt-level=3 -C link-arg=-O3 -C link-arg=-Wl,-O3 -Z dylib-lto -Z mir-opt-level=4"
RUSTFLAGS+=" -Z llvm-writable=on -Z inline-llvm=on -Z inline-mir=on -Z verify-llvm-ir=on -Z validate-mir=on -C link-self-contained=off -Z checksum-hash-algorithm=sha256"
RUSTFLAGS+=" -C link-arg=-g -C link-arg=-g3 -C link-arg=-gdwarf-5 -C link-arg=-gdwarf64 -g -Z dwarf-version=5 -Z embed-source=on -Z src-hash-algorithm=sha256 -Z debug-info-type-line-numbers=on -Z debuginfo-for-profiling=on -Z annotate-moves=on"
RUSTFLAGS+=" --edition=2024 -C relocation-model=pic -C link-arg=-fpic -C relro-level=partial --emit=obj --out-dir=target/release/artefacts"
RUSTFLAGS+=" -Funsafe_op_in_unsafe_fn -Wclippy::pedantic -Wclippy::nursery -Wclippy::suspicious -Wclippy::as_conversions -Wclippy::min_ident_chars -Wclippy::pattern_type_mismatch -Wclippy::use_self -Wclippy::unused_trait_names -Wclippy::create_dir -Fclippy::exit -Wclippy::float_cmp -Wclippy::float_cmp_const -Wclippy::while_float -Wclippy::integer_divison -Wclippy::integer_division_remainder_used -Wclippy::unreadable_literal -Wclippy::unnecessary_literal_bound -Wclippy::missing_const_for_fn -Wclippy::needless_collect -Wclippy::needless_for_each -Wclippy::as_underscore -Wclippy::branches_sharing_code -Wclippy::infinite_loop -Wclippy::linkedlist -Wclippy::pub_use -Wclippy::wildcard_imports -Wclippy::uninlined_format_args -Wclippy::equatable_if_let -Wclippy::enum_glob_use -Fclippy::panic -Fclippy::panic_in_result_fn -Fclippy::undocumented_unsafe_blocks -Fclippy::multiple_unsafe_ops_per_block -Fclippy::missing_safety_doc -Aclippy::tabs_in_doc_comments -Aclippy::unnecessary_semicolon -Aclippy::default_trait_access -Aclippy::upper_case_acronyms -Aclippy::borrowed_box"
case "$CC_TYPE" in
	"clang")
		RUSTFLAGS+=" -C link-arg=-femit-all-decls"
		;;
	"gcc")
		;;
	*)
		;;
esac

$RUSTC $RUSTFLAGS src/internal/__checks.rs
rm target/release/artefacts/__checks.o

$RUSTC $RUSTFLAGS src/stdlib/_exit.rs
$RUSTC $RUSTFLAGS src/sys/utsname.rs
$RUSTC $RUSTFLAGS src/unistd/symlink.rs
$RUSTC $RUSTFLAGS src/ctype/classification.rs

OBJECT_FILES="
	target/release/artefacts/__mavitix_unreachable_impl.o
	target/release/artefacts/libc-version.o
	target/release/artefacts/stdio__init.o
	target/release/artefacts/start_main.o
	target/release/artefacts/environ.o
	target/release/artefacts/_exit.o
	target/release/artefacts/utsname.o
	target/release/artefacts/symlink.o
	target/release/artefacts/classification.o
"

case "$CC_TYPE" in
	"clang")
		if command -v llvm-config >/dev/null 2>&1 && LLVM_GOLD="$(llvm-config --libdir)/LLVMgold.so" && test -f "$LLVM_GOLD"; then
			LDFLAGS+=" -plugin $LLVM_GOLD -plugin-opt=O3"
			ARFLAGS+=" --plugin $LLVM_GOLD"
			RANLIBFLAGS+=" --plugin $LLVM_GOLD"
		fi
		unset LLVM_GOLD
		;;
	"gcc")
		LIBLTO_PLUGIN="$($CC -print-prog-name=liblto_plugin.so)"
		LTO_WRAPPER="$($CC -print-prog-name=lto-wrapper)"
		if test -f "$LIBLTO_PLUGIN" && test -f "$LTO_WRAPPER"; then
			if [ -z "$COLLECT_GCC" ]; then export COLLECT_GCC="$CC"; fi
			if [ -z "$COLLECT_GCC_OPTIONS" ]; then export COLLECT_GCC_OPTIONS="$CFLAGS"; fi
			LDFLAGS+=" -plugin $LIBLTO_PLUGIN -plugin-opt=$LTO_WRAPPER -plugin-opt=-fresolution=target/release/tmp/gcc.res"
			ARFLAGS+=" --plugin $LIBLTO_PLUGIN"
			RANLIBFLAGS+=" --plugin $LIBLTO_PLUGIN"
		fi
		unset LIBLTO_PLUGIN
		;;
	*)
		;;
esac

# https://sourceware.org/binutils/docs/ld.html
# TODO: `--no-undefined-version`, `--default-symver`
# Would enable `-z initfirst`, but that also says "Similarly, the runtime finalisation of the object will occur after the runtime finalisation of any other objects."
LDFLAGS+=" -O3 --relax -nostdlib -z relro -z memory-seal -z global -z text -z combreloc --warn-execstack --build-id"
if [ "$architecture" = "x86-64" ]; then
	LDFLAGS+=" -z isa-level-report=all"
fi

#set -x

$LD $LDFLAGS \
	-shared -soname libc.so.6 \
	$OBJECT_FILES \
	-o target/release/libc.so.6

$AR $ARFLAGS rcs target/release/libc.a $OBJECT_FILES

cp target/release/artefacts/crt1.o target/release/crt1.o

# It's unclear whether this is stricly needed.
#$RANLIB $RANLIBFLAGS target/release/libc.a

set +x

#! /usr/bin/env bash

set -e

# https://stackoverflow.com/a/52674277

options=$(getopt -s "bash" -l "help,verbose-ub-checks,use-ranlib,no-ibt-plt,no-shadowstack,strip" -o "hv" -- "$@")

eval set -- "$options"

__help() {
cat << EOF
Usage:
	./build
		[-h|--help]
		[-v]
		[--verbose-ub-checks]
		[--use-ranlib]
		[--no-ibt-plt]
		[--no-shadowstack]
		[--strip]
EOF
}

opt__use_ranlib="false"
opt__ibt_plt="true"
opt__shadowstack="true"
opt__strip="false"

while true; do
	case "$1" in
		"-h"|"--help")
			__help
			exit 0
			;;
		"--verbose-ub-checks")
			CPPFLAGS+=" -D__MAVITIX_VERBOSE_UB_CHECKS"
			CFLAGS+=" -D__MAVITIX_VERBOSE_UB_CHECKS"
			RUSTFLAGS+=" --cfg=feature=\"verbose-ub-checks\""
			;;
		"--use-ranlib")
			opt__use_ranlib="true"
			;;
		"--no-ibt-plt")
			opt__ibt_plt="false"
			;;
		"--no-shadowstack")
			opt__shadowstack="false"
			;;
		"--strip")
			opt__strip="true"
			;;
		"-v")
			set -x
			;;
		"--")
			shift
			break
			;;
	esac
	shift
done

rm -rf target
mkdir -p target/release
mkdir -p target/release/tmp
mkdir -p target/release/artefacts

if [ -z "$CPP" ]; then CPP="cpp"; fi
if [ -z "$AS" ]; then AS="as"; fi
if [ -z "$CC" ]; then CC="cc"; fi
if [ -z "$LD" ]; then LD="ld"; fi
if [ -z "$AR" ]; then AR="ar"; fi
if [ -z "$RANLIB" ]; then RANLIB="ranlib"; fi
if [ -z "$RUSTC" ]; then RUSTC="rustc"; fi
if [ -z "$STRIP" ]; then STRIP="strip"; fi

case "$($CC --version)" in
	*"clang"*)
		CC_TYPE="clang"
		;;
	*"gcc"*)
		CC_TYPE="gcc"
		;;
	*)
		CC_TYPE="unknown"
		;;
esac

ASFLAGS+=" -mnaked-reg --warn -mrelax-relocations=yes --divide"
ASFLAGS+=" -gdwarf-5 -g --gsframe --gsframe-3 --gdwarf-cie-version=4"

architecture="$(uname -m | sed -e 's/x86_64/x86-64/g')"

if [ "$architecture" = "x86-64" ]; then
	ASFLAGS+=" --64 -O2 -mintel64 -msyntax=intel -mmnemonic=intel -mx86-used-note=yes"
fi

CPPFLAGS+=" -fdirectives-only -nostdlib -nostdinc -std=c23"
CPPFLAGS+=" -Wpedantic -Wextra -Wall -Werror -Wundef -Wtrigraphs"

$CPP $CPPFLAGS "src/crt/crt1_$architecture.S" -o target/release/tmp/crt1.s
$AS $ASFLAGS target/release/tmp/crt1.s -o target/release/artefacts/crt1.o

$CPP $CPPFLAGS "src/info.S" -o target/release/tmp/info.s
$AS $ASFLAGS target/release/tmp/info.s -o target/release/artefacts/info.o

$CPP $CPPFLAGS src/stddef/__mavitix_unreachable_impl.S -o target/release/tmp/__mavitix_unreachable_impl.s
$AS $ASFLAGS target/release/tmp/__mavitix_unreachable_impl.s -o target/release/artefacts/__mavitix_unreachable_impl.o

$CPP $CPPFLAGS src/unistd/getuid_x86-64.S -o target/release/tmp/getuid.s
$AS $ASFLAGS target/release/tmp/getuid.s -o target/release/artefacts/getuid.o

$CPP $CPPFLAGS src/unistd/getgid_x86-64.S -o target/release/tmp/getgid.s
$AS $ASFLAGS target/release/tmp/getgid.s -o target/release/artefacts/getgid.o

# https://clang.llvm.org/docs/ClangCommandLineReference.html#cmdoption-clang-fcf-protection
# https://gcc.gnu.org/onlinedocs/gcc/Instrumentation-Options.html#index-fcf-protection
# https://doc.rust-lang.org/nightly/unstable-book/compiler-flags/cf-protection.html
CFLAGS+=" -fcf-protection -fno-fast-math"
CFLAGS+=" -nostdlib -nostdinc -nostartfiles -nodefaultlibs -nolibc -ffreestanding"
CFLAGS+=" -isysteminclude -std=c23 -O3 -m64 -march=native -mtune=native -fpic"
CFLAGS+=" -g -g3 -gdwarf-5 -gdwarf64 -fdebug-types-section"
CFLAGS+=" -Wpedantic -Wextra -Wall -Werror -Wundef -Wtrigraphs -Wunknown-pragmas -Wno-error=unused-parameter -Wno-error=unused-variable -Wzero-as-null-pointer-constant"
case "$CC_TYPE" in
	"clang")
		CFLAGS+=" -Wno-error=#warnings -Wno-error=unused-command-line-argument"
		CFLAGS+=" -fno-knr-functions -fno-digraphs -fno-trigraphs -femit-all-decls"
		CFLAGS+=" -gembed-source"
		;;
	"gcc")
		CFLAGS+=" -Wno-error=attributes"
		# https://gcc.gnu.org/onlinedocs/gcc/Debugging-Options.html#index-gas-loc-support
		# Surprisingly, even source-built clang 23 doesn't support this.
		CFLAGS+=" -gas-loc-support"
		;;
	*)
		;;
esac

$CC $CFLAGS src/stdio/__init.c -c -o target/release/artefacts/stdio__init.o
$CC $CFLAGS src/crt/start_main.c -c -o target/release/artefacts/start_main.o

# TODO: `-Z implicit-sysroot-deps=no` means the build-std stuff for `$(uname -m)-unknown-linux-none` could potentially work
# FIXME: https://github.com/rust-lang/rust/issues/56068
RUSTFLAGS+=" --check-cfg=cfg(feature,values(\"verbose-ub-checks\"))"
RUSTFLAGS+=" -Z unstable-options -C debug-assertions=no -C panic=immediate-abort -Z panic-in-drop=immediate-abort -C link-dead-code=on"
RUSTFLAGS+=" -C link-arg=-nostdlib -C link-arg=-nostdinc -C link-arg=-nostartfiles -C link-arg=-nodefaultlibs -C link-arg=-nolibc -C link-arg=-ffreestanding"
RUSTFLAGS+=" -C link-arg=-fcf-protection -C link-arg=-fno-fast-math -Z cf-protection=full -C overflow-checks=off -Z trap-unreachable=on -Z extra-const-ub-checks=on -Z human-readable-cgu-names=on"
RUSTFLAGS+=" -C target-cpu=native -Z tune-cpu=native -C lto=fat -C codegen-units=1 -C opt-level=3 -C link-arg=-O3 -C link-arg=-Wl,-O3 -Z dylib-lto -Z mir-opt-level=4 -Z relax-elf-relocations=on"
RUSTFLAGS+=" -Z llvm-writable=on -Z inline-llvm=on -Z inline-mir=on -Z verify-llvm-ir=on -Z validate-mir=on -C link-self-contained=off -Z checksum-hash-algorithm=sha256"
RUSTFLAGS+=" -C link-arg=-g -C link-arg=-g3 -C link-arg=-gdwarf-5 -C link-arg=-gdwarf64 -C link-arg=-fdebug-types-section -g -Z dwarf-version=5 -Z embed-source=on -Z src-hash-algorithm=sha256 -Z debug-info-type-line-numbers=on -Z debuginfo-for-profiling=on -Z annotate-moves=on"
RUSTFLAGS+=" --edition=2024 -C relocation-model=pic -C link-arg=-fpic -C relro-level=partial --emit=obj --out-dir=target/release/artefacts"
RUSTFLAGS+=" -Funsafe_op_in_unsafe_fn -Wclippy::pedantic -Wclippy::nursery -Wclippy::suspicious -Wclippy::as_conversions -Wclippy::min_ident_chars -Wclippy::pattern_type_mismatch -Wclippy::use_self -Wclippy::unused_trait_names -Wclippy::create_dir -Fclippy::exit -Wclippy::float_cmp -Wclippy::float_cmp_const -Wclippy::while_float -Wclippy::integer_divison -Wclippy::integer_division_remainder_used -Wclippy::unreadable_literal -Wclippy::unnecessary_literal_bound -Wclippy::missing_const_for_fn -Wclippy::needless_collect -Wclippy::needless_for_each -Wclippy::as_underscore -Wclippy::branches_sharing_code -Wclippy::infinite_loop -Wclippy::linkedlist -Wclippy::pub_use -Wclippy::wildcard_imports -Wclippy::uninlined_format_args -Wclippy::equatable_if_let -Wclippy::enum_glob_use -Fclippy::panic -Fclippy::panic_in_result_fn -Fclippy::undocumented_unsafe_blocks -Fclippy::multiple_unsafe_ops_per_block -Fclippy::missing_safety_doc -Aclippy::tabs_in_doc_comments -Aclippy::unnecessary_semicolon -Aclippy::default_trait_access -Aclippy::upper_case_acronyms -Aclippy::borrowed_box"
case "$CC_TYPE" in
	"clang")
		RUSTFLAGS+=" -C link-arg=-femit-all-decls"
		;;
	"gcc")
		;;
	*)
		;;
esac

$RUSTC $RUSTFLAGS src/internal/__checks.rs
rm target/release/artefacts/__checks.o

$RUSTC $RUSTFLAGS src/stdlib/_exit.rs
$RUSTC $RUSTFLAGS src/sys/utsname.rs
$RUSTC $RUSTFLAGS src/unistd/symlink.rs
$RUSTC $RUSTFLAGS src/ctype/classification.rs
$RUSTC $RUSTFLAGS src/crt/libc_init.rs
$RUSTC $RUSTFLAGS src/env/environ.rs
$RUSTC $RUSTFLAGS src/gnu/libc_version.rs
$RUSTC $RUSTFLAGS src/mem/mem.rs
$RUSTC $RUSTFLAGS src/str/strlen.rs

OBJECT_FILES="
	target/release/artefacts/info.o
	target/release/artefacts/__mavitix_unreachable_impl.o
	target/release/artefacts/getuid.o
	target/release/artefacts/getgid.o
	target/release/artefacts/stdio__init.o
	target/release/artefacts/start_main.o
	target/release/artefacts/_exit.o
	target/release/artefacts/utsname.o
	target/release/artefacts/symlink.o
	target/release/artefacts/classification.o
	target/release/artefacts/libc_init.o
	target/release/artefacts/environ.o
	target/release/artefacts/libc_version.o
	target/release/artefacts/mem.o
	target/release/artefacts/strlen.o
"

case "$CC_TYPE" in
	"clang")
		if command -v llvm-config >/dev/null 2>&1 && LLVM_GOLD="$(llvm-config --libdir)/LLVMgold.so" && test -f "$LLVM_GOLD"; then
			LDFLAGS+=" -plugin $LLVM_GOLD -plugin-opt=O3"
			ARFLAGS+=" --plugin $LLVM_GOLD"
			RANLIBFLAGS+=" --plugin $LLVM_GOLD"
		fi
		unset LLVM_GOLD
		;;
	"gcc")
		LIBLTO_PLUGIN="$($CC -print-prog-name=liblto_plugin.so)"
		LTO_WRAPPER="$($CC -print-prog-name=lto-wrapper)"
		if test -f "$LIBLTO_PLUGIN" && test -f "$LTO_WRAPPER"; then
			if [ -z "$COLLECT_GCC" ]; then export COLLECT_GCC="$CC"; fi
			if [ -z "$COLLECT_GCC_OPTIONS" ]; then export COLLECT_GCC_OPTIONS="$CFLAGS"; fi
			LDFLAGS+=" -plugin $LIBLTO_PLUGIN -plugin-opt=$LTO_WRAPPER -plugin-opt=-fresolution=target/release/tmp/gcc.res"
			ARFLAGS+=" --plugin $LIBLTO_PLUGIN"
			RANLIBFLAGS+=" --plugin $LIBLTO_PLUGIN"
		fi
		unset LIBLTO_PLUGIN
		;;
	*)
		;;
esac

# https://research.google/pubs/safe-icf-pointer-safe-and-unwinding-aware-identical-code-folding-in-gold/
# https://sourceware.org/binutils/docs/ld.html
LDFLAGS+=" -O3 --relax -nostdlib -z lazy -z relro -z memory-seal -z global -z text -z combreloc -z unique -z nodelete -z sectionheader -z initfirst --error-execstack --eh-frame-hdr --enable-new-dtags --build-id --demangle --gc-sections --enable-linker-version"
if [ "$architecture" = "x86-64" ]; then
	LDFLAGS+=" -z isa-level-report=all -z pack-relative-relocs -z mark-plt"
	if [ "$opt__ibt_plt" = "true" ]; then
		LDFLAGS+=" -z ibt -z ibtplt"
	fi
	if [ "$opt__shadowstack" = "true" ]; then
		LDFLAGS+=" -z shstk"
	fi
fi
case "$($LD --version | tr '[:upper:]' '[:lower:]')" in
	*"wild"*)
		# https://github.com/wild-linker/wild/issues/1576 [SFrame 3]
		# https://github.com/wild-linker/wild/issues/1156 [Weak Symbols]
		# https://github.com/wild-linker/wild/issues/1088 [Garbage Collect Debug Information]
		# https://github.com/wild-linker/wild/issues/2650 [-z {ibt,}plt]
		;;
	*"gold"*)
		export LDFLAGS="$(echo $LDFLAGS | sed -e 's/ \{0,\}--error-execstack//g' -e 's/ \{0,\}-z \{0,\}memory-seal//g' -e 's/ \{0,\}-z \{0,\}sectionheader//g' -e 's/ \{0,\}-z \{0,\}isa-level-report=all//g' -e 's/ \{0,\}-z \{0,\}pack-relative-relocs//g' -e 's/ \{0,\}-z \{0,\}ibt\(plt\)\{0,1\}//g')"
		LDFLAGS+=" --icf=safe"
		;;
	*"lld"*|*"mold 2"*)
		# ld.lld: error: target/release/artefacts/stdio__init.o:(.debug_names): found DWARF64, which is currently unsupported
		# ld.lld: error: target/release/artefacts/start_main.o:(.debug_names): found DWARF64, which is currently unsupported
		# LDFLAGS+=" --debug-names"
		# `ld.lld` is not actually "compatible with GNU linkers"; see: https://github.com/llvm/llvm-project/issues/233006
		export LDFLAGS="$(echo $LDFLAGS | sed -e 's/ \{0,\}--error-execstack//g' -e 's/ \{0,\}--enable-linker-version//g')"
		LDFLAGS+=" --icf=safe"
		;;
	*"mold"*)
		# mold 0.x, 1.x, 3.x, and any future versions
		# Welcome to `User-Agent` hell
		echo "Slopware detected; terminating..."
		exit 1
		;;
	*"gnu ld"*)
		# A lot of "compatible with GNU linkers" programs do not actually support all ld.bfd options.
		LDFLAGS+=" --enable-linker-version --error-rwx-segments"
		if [ "$architecture" = "x86-64" ]; then
			LDFLAGS+=" --no-gnu2-tls-tag"
		fi
		;;
	*)
		echo "Unknown linker '$LD'; some options or flags may not be applied"
		;;
esac

$LD $LDFLAGS \
	-shared -soname libc.so.6 \
	$OBJECT_FILES \
	-o target/release/libc.so.6

if [ "$opt__use_ranlib" = "true" ]; then
	ARFLAGS+=" rc"
else
	ARFLAGS+=" rcs"
fi

$AR $ARFLAGS target/release/libc.a $OBJECT_FILES

if [ "$opt__use_ranlib" = "true" ]; then
	$RANLIB $RANLIBFLAGS target/release/libc.a
fi

cp target/release/artefacts/crt1.o target/release/crt1.o

if [ "$opt__strip" = "true" ]; then
	find target -type f -not -name '*.s' -execdir $STRIP $STRIPFLAGS {} +
fi
